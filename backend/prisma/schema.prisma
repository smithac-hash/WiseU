generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id            String         @id @default(cuid())
  name          String
  email         String         @unique
  passwordHash  String
  monthlyIncome Float          @default(0)
  savingsGoal   Float          @default(0)
  createdAt     DateTime       @default(now())
  budgets       Budget[]
  expenses      Expense[]
  notifications Notification[]

  @@map("users")
}

model Expense {
  id        String   @id @default(cuid())
  userId    String
  amount    Float
  category  Category
  note      String?
  date      DateTime
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([date])
  @@map("expenses")
}

model Budget {
  id           String   @id @default(cuid())
  userId       String
  category     Category
  monthlyLimit Float
  month        String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, category, month])
  @@index([userId])
  @@map("budgets")
}

model Notification {
  id        String   @id @default(cuid())
  userId    String
  message   String
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("notifications")
}

enum Category {
  FOOD
  TRANSPORT
  SHOPPING
  ENTERTAINMENT
  EDUCATION
  HEALTH
  UTILITIES
  OTHER
}
